# Copy to .env.local and fill in. All VITE_* vars are exposed to the browser
# (that's fine — the anon key is public and gated by Row Level Security).

# --- Supabase (browser) ---
# Sign-in is handled in the app (against the sales:users table), so only the
# public URL + anon key are needed. No service-role key required.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI proxy (/api/claude), server-only ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5 (cheapest — $1/$5 per Mtok). Set to
# claude-sonnet-5 ($3/$15) for sharper stage-gate interviews, or claude-opus-4-8
# ($5/$25) for maximum quality.
ANTHROPIC_MODEL=
